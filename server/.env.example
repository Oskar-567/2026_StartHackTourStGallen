# Local development settings. Copy to .env (PowerShell: Copy-Item .env.example .env).
DEBUG=True
SECRET_KEY=dev-only-not-secret
DATABASE_URL=postgres://app:app@127.0.0.1:5433/app
# "*" lets phones on your Wi-Fi reach runserver via your LAN IP. Never use "*" in production.
ALLOWED_HOSTS=*
# Expo web dev server
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Viseca "Agent on a Leash" challenge API (server/viseca/, api/services.py).
VISECA_BASE_URL=https://saw26api.ashyground-364e1d07.switzerlandnorth.azurecontainerapps.io
VISECA_API_KEY=your-team-key-here
# Local clone of the challenge data pack (data/ dir), used only by `manage.py replay`
# (no network, no API key). Never a hard-coded path -- see CLAUDE.md.
VISECA_DATA_DIR=C:\path\to\viseca-2026\data
